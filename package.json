{
  "name": "@chiikawarden/desktop",
  "version": "0.1.0",
  "description": "Chiikawarden is an alternative client for the Bitwarden® platform, providing a modern and secure way to manage your passwords and sensitive information.",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:ui": "rsbuild dev",
    "build:ui": "rsbuild build",
    "serve": "rsbuild preview",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "prebuild:ui": "bun run i18n:compile",
    "predev:ui": "bun run i18n:compile",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "vitest",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules/.rsbuild",
    "clean:storage": "tsx scripts/clean-storage.ts --force",
    "clean:all": "bun run clean && bun run clean:storage",
    "dev:debug": "RUST_LOG=debug tauri dev",
    "build:debug": "RUST_LOG=debug tauri build --debug",
    "debug:cipher-decryption": "tsx scripts/debug-cipher-decryption.ts",
    "analyze": "rsbuild build --analyze",
    "prepare": "lefthook install",
    "hooks:install": "lefthook install",
    "hooks:uninstall": "lefthook uninstall",
    "hooks:run": "lefthook run pre-commit",
    "hooks:test": "lefthook run pre-push",
    "commit:lint": "commitlint --from HEAD~1 --to HEAD --verbose",
    "commit:check": "commitlint --edit --verbose",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/inter": "^5.2.6",
    "@fontsource/poppins": "^5.2.6",
    "@heroui/button": "^2.2.22",
    "@heroui/checkbox": "^2.3.21",
    "@heroui/dropdown": "^2.3.22",
    "@heroui/form": "^2.1.23",
    "@heroui/input": "^2.4.22",
    "@heroui/link": "^2.2.19",
    "@heroui/modal": "^2.2.19",
    "@heroui/radio": "^2.3.21",
    "@heroui/react": "^2.8.0",
    "@heroui/select": "^2.4.22",
    "@heroui/switch": "^2.2.20",
    "@heroui/system": "^2.4.18",
    "@heroui/tabs": "^2.2.20",
    "@heroui/theme": "^2.4.17",
    "@heroui/toast": "^2.0.13",
    "@hookform/resolvers": "5.1.1",
    "@lingui/core": "^5.3.3",
    "@lingui/macro": "^5.3.3",
    "@lingui/react": "^5.3.3",
    "@tailwindcss/postcss": "^4.1.11",
    "@tanstack/react-query": "^5.81.5",
    "@tanstack/react-router": "^1.123.2",
    "@tauri-apps/api": "2.6.0",
    "@tauri-apps/plugin-log": "^2.6.0",
    "@tauri-apps/plugin-opener": "2.4.0",
    "@tauri-apps/plugin-stronghold": "^2.3.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.5",
    "lucide-react": "^0.525.0",
    "make-plural": "^7.4.0",
    "playwright": "^1.54.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.53.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "zod": "4.0.5",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@chromatic-com/storybook": "^4.0.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@lingui/cli": "^5.3.3",
    "@lingui/swc-plugin": "^5.5.2",
    "@rsbuild/core": "^1.4.6",
    "@rsbuild/plugin-node-polyfill": "^1.3.1",
    "@rsbuild/plugin-react": "^1.3.4",
    "@rsbuild/plugin-type-check": "^1.2.3",
    "@storybook/addon-a11y": "9.0.16",
    "@storybook/addon-docs": "9.0.16",
    "@storybook/addon-links": "9.0.16",
    "@storybook/addon-onboarding": "9.0.16",
    "@storybook/addon-vitest": "^9.0.16",
    "@storybook/react": "^9.0.16",
    "@tanstack/react-router-devtools": "^1.127.3",
    "@tanstack/router-plugin": "^1.124.0",
    "@tauri-apps/cli": "2.6.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.1.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitest/ui": "^3.2.4",
    "babel-loader": "^10.0.0",
    "babel-plugin-macros": "^3.1.0",
    "heroui-cli": "^1.2.3",
    "jsdom": "26.1.0",
    "lefthook": "^1.11.16",
    "react-scan": "^0.4.3",
    "storybook": "^9.0.16",
    "storybook-react-rsbuild": "^2.0.2",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.3.5",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "bun@1.2.18",
  "engines": {
    "bun": ">=1.2.18"
  }
}
