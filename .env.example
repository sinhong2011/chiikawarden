# Chiikawarden Environment Configuration
# Copy this file to .env and adjust values as needed

# Logging Configuration
# Set log levels for different components
# Levels: error, warn, info, debug, trace
RUST_LOG=chiikawarden=info,hyper_util=warn,h2=warn,warn,error

# Enable colored log output (true/false)
RUST_LOG_COLOR=true

# Debug Configuration for Development
# Enable verbose crypto operation logging (development only)
CHIIKAWARDEN_DEBUG_CRYPTO=false

# Enable token operation debugging
CHIIKAWARDEN_DEBUG_TOKEN_OPS=false

# Enable correlation ID tracking
CHIIKAWARDEN_DEBUG_CORRELATION=false

# Enable storage operation debugging
CHIIKAWARDEN_DEBUG_STORAGE=false

# Enable token validation debugging
CHIIKAWARDEN_DEBUG_TOKEN_VALIDATION=false

# General token debugging (enables all token debug features)
CHIIKAWARDEN_TOKEN_DEBUG=false

# Database Configuration
# Database connection timeout in seconds
DATABASE_TIMEOUT=30

# Enable database query logging
DATABASE_LOG_QUERIES=false

# Network Configuration
# HTTP request timeout in seconds
HTTP_TIMEOUT=30

# Enable network monitoring
NETWORK_MONITORING=true

# Network check interval in seconds
NETWORK_CHECK_INTERVAL=30

# Development Settings
# Enable development mode features
DEV_MODE=false

# Enable performance monitoring
PERFORMANCE_MONITORING=false

# Security Settings
# Enable audit logging
AUDIT_LOGGING=true

# Enable security event logging
SECURITY_LOGGING=true

# Frontend Logging Configuration
# Set frontend log levels and controls
VITE_LOG_LEVEL=info

# Disable frontend log rate limiting (for debugging)
VITE_DISABLE_LOG_RATE_LIMIT=false

# Enable verbose frontend logging (shows all component logs)
VITE_VERBOSE_LOGGING=false

# Enable frontend performance logging
VITE_PERFORMANCE_LOGGING=false

# Production Overrides
# In production, use these settings for optimal performance and security:
# RUST_LOG=chiikawarden=info,warn,error
# CHIIKAWARDEN_DEBUG_CRYPTO=false
# CHIIKAWARDEN_TOKEN_DEBUG=false
# DATABASE_LOG_QUERIES=false
# DEV_MODE=false
# PERFORMANCE_MONITORING=true
# VITE_LOG_LEVEL=warn
# VITE_VERBOSE_LOGGING=false
