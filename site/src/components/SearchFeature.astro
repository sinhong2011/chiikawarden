---
import Shot from "./Shot.astro";
import { m } from "../paraglide/messages.js";
const tokens = ["type:card", "is:favorite", "has:passkey", "#Work"].map((t) => `<code>${t}</code>`).join(" ");
---
<section id="search" class="mx-auto grid max-w-(--max) items-center gap-[5vw] px-(--gutter) py-[clamp(64px,8vw,112px)] lg:grid-cols-[minmax(0,1.2fr)_minmax(0,.8fr)]">
  <div data-rise style="--zoom-origin: 17% 5.5%; --zoom: 1.6" class="shot-zoom max-lg:order-last"><Shot name="search" alt={m.alt_search()} /></div>
  <div data-reveal-group class="[&>p:not(.kicker)]:mt-[26px] [&>p:not(.kicker)]:max-w-[440px] [&>p:not(.kicker)]:text-lg [&>p:not(.kicker)]:text-ink-2">
    <p class="kicker">{m.search_kicker()}</p>
    <h2>{m.search_title_1()}<br /><em>{m.search_title_2()}</em></h2>
    <p set:html={m.search_body({ tokens })} />
  </div>
</section>
