---
import Shot from "./Shot.astro";
import { m } from "../paraglide/messages.js";
---
<section class="mx-auto grid max-w-(--max) items-center gap-[5vw] px-(--gutter) py-[clamp(64px,8vw,112px)] lg:grid-cols-[minmax(0,1.2fr)_minmax(0,.8fr)]">
  <div data-rise style="--zoom-origin: 90% 7%; --zoom: 1.4" class="shot-zoom max-lg:order-last"><Shot name="generator" alt={m.alt_generator()} /></div>
  <div data-reveal-group class="[&>p:not(.kicker)]:mt-[26px] [&>p:not(.kicker)]:max-w-[440px] [&>p:not(.kicker)]:text-lg [&>p:not(.kicker)]:text-ink-2">
    <p class="kicker">{m.gen_kicker()}</p>
    <h2>{m.gen_title_1()}<br /><em>{m.gen_title_2()}</em></h2>
    <p>{m.gen_body()}</p>
  </div>
</section>
