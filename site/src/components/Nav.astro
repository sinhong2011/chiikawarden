---
import { versioned } from "../versioned";
import { SITE } from "../config";
import { m } from "../paraglide/messages.js";
import { latestRelease, formatSize } from "../release";
import LangSwitch from "./LangSwitch.astro";
import { currentLocale, localeHref } from "../i18n";

interface Props { page?: string }
const { page = "" } = Astro.props;
const home = page ? localeHref(currentLocale()) : "";

const rel = await latestRelease();
const dmg = rel?.dmg ?? SITE.download;
const refresh = !rel?.stable; // a fixed link never needs refreshing
// In page order.
const links = [
  [`${home}#screens`, m.nav_screens()],
  [`${home}#features`, m.nav_features()],
  [`${home}#security`, m.nav_security()],
  [`${home}#pricing`, m.nav_pricing()],
  [`${home}#faq`, m.nav_faq()],
];

// Star count at build time; the page refreshes it in the browser (scripts/nav.ts).
let stars: number | null = null;
try {
  const res = await fetch(`${SITE.api}`, { headers: { Accept: "application/vnd.github+json" } });
  if (res.ok) stars = (await res.json()).stargazers_count ?? null;
} catch {}
const downloadIcon = '<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M8 2.5v7.5M4.8 7l3.2 3.2L11.2 7M3 13.2h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<header data-nav class="topbar">
  <div class="topbar__inner">
    <a class="topbar__brand" href={page ? home : "#top"} aria-label="Triwarden">
      <img src={versioned("assets/icon.svg")} alt="" width="30" height="30" />
      <span class="topbar__name">Triwarden</span>
    </a>

    <nav class="topbar__links" aria-label={m.nav_features()} data-nav-links>
      <span class="topbar__indicator" aria-hidden="true" data-nav-indicator></span>
      {links.map(([href, label]) => <a href={href} data-nav-link>{label}</a>)}
    </nav>

    <svg class="topbar__outline" aria-hidden="true">
      <rect x="0" y="0" width="100%" height="100%" rx="22" ry="22" pathLength="1" data-nav-progress />
    </svg>

    <div class="topbar__end">
      <div class="topbar__group">
        <LangSwitch page={page} />
        <span class="topbar__divider" aria-hidden="true"></span>
        <button data-theme-toggle data-to-dark={m.nav_to_dark()} data-to-light={m.nav_to_light()} type="button" class="topbar__icon" aria-label={m.nav_to_dark()}>
          <span class="theme-swap" aria-hidden="true">
            <svg class="theme-swap__moon" viewBox="0 0 20 20" width="16" height="16"><path d="M16.5 12.2A6.8 6.8 0 0 1 7.8 3.5a6.8 6.8 0 1 0 8.7 8.7Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
            <svg class="theme-swap__sun" viewBox="0 0 20 20" width="16" height="16"><circle cx="10" cy="10" r="3.4" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M10 1.8v2M10 16.2v2M1.8 10h2M16.2 10h2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M4.2 15.8l1.4-1.4M14.4 5.6l1.4-1.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
          </span>
        </button>
        <span class="topbar__divider topbar__star-divider" aria-hidden="true"></span>
        <a class="topbar__star" href={SITE.repo} data-star-label={m.nav_star_label_count({ count: "{count}" })} aria-label={stars !== null ? m.nav_star_label_count({ count: String(stars) }) : m.nav_star_label()}>
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.88.87 2.34.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"/></svg>
          <svg class="topbar__star-icon" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M8 1.5l1.9 4 4.3.5-3.2 3 .9 4.3L8 11.1l-3.9 2.2.9-4.3-3.2-3 4.3-.5Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
          <span data-stars>{stars ?? "–"}</span>
        </a>
      </div>

      <a class="btn btn--fill btn--sm topbar__download" href={dmg} data-dmg={refresh ? "" : undefined}>
        <Fragment set:html={downloadIcon} />{m.nav_download()}
      </a>

      <button type="button" class="topbar__menu" data-nav-menu aria-expanded="false" aria-controls="nav-sheet" data-open-label={m.nav_menu()} data-close-label={m.nav_close()} aria-label={m.nav_menu()}>
        <span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div id="nav-sheet" class="topbar__sheet" data-nav-sheet hidden>
    <nav aria-label={m.nav_features()}>
      {links.map(([href, label]) => <a href={href} data-sheet-link>{label}</a>)}
    </nav>
    <a class="btn btn--fill topbar__sheet-download" href={dmg} data-dmg={refresh ? "" : undefined}><Fragment set:html={downloadIcon} />{m.hero_download()}{rel && <span class="font-normal opacity-70">· <span data-dmg-size>{formatSize(rel.size)}</span></span>}</a>
  </div>
</header>

<script>import "../scripts/nav";</script>
