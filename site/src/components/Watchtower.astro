---
import Shot from "./Shot.astro";
import { m } from "../paraglide/messages.js";
---
<section class="mx-auto grid max-w-(--max) items-center gap-[5vw] px-(--gutter) py-[clamp(64px,8vw,112px)] lg:grid-cols-[minmax(0,.8fr)_minmax(0,1.2fr)]">
  <div data-reveal-group class="[&>p:not(.kicker)]:mt-[26px] [&>p:not(.kicker)]:max-w-[440px] [&>p:not(.kicker)]:text-lg [&>p:not(.kicker)]:text-ink-2">
    <p class="kicker">{m.wt_kicker()}</p>
    <h2>{m.wt_title_1()}<br /><em>{m.wt_title_2()}</em></h2>
    <p>{m.wt_p1()}</p>
    <p>{m.wt_p2()}</p>
  </div>
  <div data-rise style="--zoom-origin: 87% 6.5%; --zoom: 1.45" class="shot-zoom"><Shot name="watchtower" alt={m.alt_watchtower()} /></div>
</section>
