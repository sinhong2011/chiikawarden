---
import SectionHead from "./SectionHead.astro";
import { m } from "../paraglide/messages.js";
const steps = [1, 2, 3, 4].map((n) => {
  const t = m as unknown as Record<string, () => string>;
  return { label: t[`lock${n}_label`](), title: t[`lock${n}_title`](), body: t[`lock${n}_body`]() };
});
const marks = ["01", "02", "03", "✓"];
---
<!-- One screen: the dial beside the three locks (and the door opening). Pointing at a lock turns the dial to it; in view,
     it steps through them on its own. -->
<section id="security" class="mx-auto grid max-w-(--max) items-center gap-x-[5vw] gap-y-10 px-(--gutter) py-[clamp(64px,8vw,112px)] *:min-w-0 lg:grid-cols-[minmax(0,.85fr)_minmax(0,1.15fr)]">
  <div class="grid place-items-center">
    <div data-dial="guards" aria-hidden="true" class="aspect-square w-[min(36vw,480px)] max-lg:w-[min(64vw,320px)]"></div>
  </div>
  <div>
    <SectionHead kicker={m.security_kicker()} class="[&_h2]:text-[clamp(40px,4.6vw,66px)]!">
      <h2>{m.security_title_1()}<br /><em>{m.security_title_2()}</em></h2>
      <p>{m.security_lede()}</p>
    </SectionHead>
    <ol class="mt-7 grid list-none gap-3 p-0 sm:grid-cols-2" data-steps>
      {steps.map((s, i) => (
        <li data-step={i} tabindex="0" class="lock-step">
          <span class="lock-step__mark" aria-hidden="true">{marks[i]}</span>
          <p class="lock-step__label">{s.label}</p>
          <h3 class="lock-step__title">{s.title}</h3>
          <p class="lock-step__body">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>import "../scripts/guards";</script>
