        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有弱、重複或不安全的密碼。檢查一下是否外洩會更安心。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
