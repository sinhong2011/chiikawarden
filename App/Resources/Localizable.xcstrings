    "That doesn't look like a valid one-time code secret.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なワンタイムコードのシークレットではないようです。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這看起來不是有效的一次性驗證碼密匙。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这看起来不是有效的一次性验证码密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這看起來不是有效的一次性驗證碼密鑰。"
          }
        }
      }
    },
    "That file isn't a certificate.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは証明書ではありません。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "該檔案不是憑證。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件不是证书。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該檔案不是憑證。"
          }
        }
      }
    },
    "The file is removed from your vault on every device.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案會從你所有裝置上的保險庫中移除。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案會從你所有裝置上的保險庫中移除。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件会从你所有设备上的密码库中移除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデバイスの保管庫からファイルが削除されます。"
          }
        }
      }
    },
    "The server sent unsafe key-derivation settings. Login was stopped.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーから安全でない鍵導出設定が送られたため、ログインを中止しました。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器傳回不安全的金鑰衍生設定，已停止登入。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器返回了不安全的密钥派生设置，已停止登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器傳回不安全的金鑰衍生設定，已停止登入。"
          }
        }
      }
    },
    "These passwords appear in known breaches. Change them on each site.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのパスワードは既知の漏えいに含まれています。各サイトで変更してください。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這些密碼出現在已知的外洩資料中，請到各網站更改。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些密码出现在已知的泄露数据中，请到各网站更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些密碼出現在已知的外洩資料中，請到各網站更改。"
          }
        }
      }
    },
    "These sites are saved with http://, so the password travels unencrypted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのサイトは http:// で保存されており、パスワードが暗号化されずに送信されます。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這些網站以 http:// 儲存，密碼會以未加密方式傳送。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些网站以 http:// 保存，密码会以未加密方式传输。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些網站以 http:// 儲存，密碼會以未加密方式傳送。"
          }
        }
      }
    },
    "This Mac has no Touch ID available.": {
