    "Short or simple passwords are easy to guess. Generate a longer one.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短い・単純なパスワードは推測されやすいです。長いものを生成しましょう。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "過短或過於簡單的密碼容易被猜中。請產生更長的密碼。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过短或过于简单的密码容易被猜中。请生成更长的密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過短或過於簡單的密碼容易被猜中。請產生更長的密碼。"
          }
        }
      }
    },
