    "Add your own CA if your server uses a private or self-signed certificate (PEM or DER).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがプライベートまたは自己署名の証明書を使う場合は、独自の CA（PEM または DER）を追加してください。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "若伺服器使用私有或自簽憑證，請加入你的 CA（PEM 或 DER）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果服务器使用私有或自签名证书，请添加你的 CA（PEM 或 DER）。"
