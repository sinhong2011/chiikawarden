    "Share text or a file with anyone through an encrypted link that expires.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限付きの暗号化リンクで、テキストやファイルを誰とでも共有できます。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "透過會到期的加密連結，同任何人分享文字或檔案。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过会过期的加密链接，与任何人分享文字或文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過會到期的加密連結，與任何人分享文字或檔案。"
          }
        }
      }
    },
