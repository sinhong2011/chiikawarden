        }
      }
    },
    "Copies an item's password. It's cleared from the clipboard after the delay set in Chiikawarden.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目のパスワードをコピーします。Chiikawarden で設定した時間が経つとクリップボードから消去されます。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "複製項目的密碼，並喺 Chiikawarden 設定的時間後從剪貼簿清除。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
