    "Bitwarden asked for a captcha. Log in once at vault.bitwarden.com from this network, then try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitwarden から CAPTCHA を求められました。このネットワークから一度 vault.bitwarden.com にログインしてから、もう一度お試しください。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitwarden 要求驗證碼挑戰。請先在這個網路下登入一次 vault.bitwarden.com，再重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitwarden 要求人机验证。请先在此网络下登录一次 vault.bitwarden.com，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitwarden 要求驗證碼挑戰。請先在這個網路下登入一次 vault.bitwarden.com，再重試。"
          }
        }
      }
    },
    "Bitwarden emailed a verification code to %@.": {
      "localizations": {
