    "Wrong email or master password.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスまたはマスターパスワードが正しくありません。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "電郵或主密碼錯誤。"
          }
        },
        "zh-Hans": {
