          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案會從你所有裝置上的保險庫中移除。"
          }
        }
      }
    },
    "The link holds the key; the server never sees your content.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵はリンクの中にあり、サーバーは内容を見られません。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "密鑰喺連結入面，伺服器永遠睇唔到內容。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥在链接中，服务器永远看不到内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰在連結中，伺服器永遠看不到內容。"
          }
        }
      }
    },
    "The link stops working immediately.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクはすぐに使えなくなります。"
