            "value": "すべてのデバイスの保管庫からファイルが削除されます。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案會從你所有裝置上的保險庫中移除。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
