{
  "sourceLanguage": "en",
  "strings": {
    "Lock Vault": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定保險庫"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定密码库"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫をロック"
          }
        }
      }
    },
    "Two-step verification": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩步驟驗證"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两步验证"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2 段階認証"
          }
        }
      }
    },
    "Unlock your vault": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖你的保險庫"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁你的密码库"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫のロックを解除"
          }
        }
      }
    },
    "Enter the 6-digit code from your authenticator app.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入驗證器 App 中的 6 位數驗證碼。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入验证器 App 中的 6 位验证码。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証アプリに表示される 6 桁のコードを入力してください。"
          }
        }
      }
    },
    "Sign in to your Vaultwarden server.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入你的 Vaultwarden 伺服器。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录你的 Vaultwarden 服务器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaultwarden サーバーにサインインします。"
          }
        }
      }
    },
    "Verification code": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證碼"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证码"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認コード"
          }
        }
      }
    },
    "Server URL": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器網址"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器网址"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー URL"
          }
        }
      }
    },
    "Email": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電子郵件"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电子邮件"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレス"
          }
        }
      }
    },
    "Master password": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主密碼"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主密码"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスターパスワード"
          }
        }
      }
    },
    "Verify": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認"
          }
        }
      }
    },
    "Log in": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン"
          }
        }
      }
    },
    "Enter a valid server URL.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入有效的伺服器網址。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的服务器网址。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なサーバー URL を入力してください。"
          }
        }
      }
    },
    "This account uses Argon2id, which isn't supported yet.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號使用 Argon2id，目前尚未支援。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户使用 Argon2id，目前尚不支持。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントは Argon2id を使用していますが、まだサポートされていません。"
          }
        }
      }
    },
    "The server sent unsafe key-derivation settings. Login was stopped.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器傳回不安全的金鑰衍生設定，已停止登入。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器返回了不安全的密钥派生设置，已停止登录。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーから安全でない鍵導出設定が送られたため、ログインを中止しました。"
          }
        }
      }
    },
    "Wrong email or master password.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電子郵件或主密碼錯誤。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电子邮件或主密码错误。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスまたはマスターパスワードが正しくありません。"
          }
        }
      }
    },
    "Server error (%lld).": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器錯誤（%lld）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器错误（%lld）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーエラー（%lld）。"
          }
        }
      }
    },
    "Vault": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保險庫"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码库"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫"
          }
        }
      }
    },
    "All Items": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有項目"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有项目"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての項目"
          }
        }
      }
    },
    "Favorites": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我的最愛"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入り"
          }
        }
      }
    },
    "Search": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索"
          }
        }
      }
    },
    "No Item Selected": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未選取項目"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未选择项目"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目が選択されていません"
          }
        }
      }
    },
    "%lld organization items are hidden until org keys are supported.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在支援組織金鑰之前，已隱藏 %lld 個組織項目。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在支持组织密钥之前，已隐藏 %lld 个组织项目。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "組織キーに対応するまで、組織の項目 %lld 件は非表示です。"
          }
        }
      }
    },
    "2FA": {
      "shouldTranslate": false
    },
    "Username": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用者名稱"
          }
        },
        "zh-Hans": {
