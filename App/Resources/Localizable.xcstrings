    "Add a code secret to a login to see it here.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在登入項目加入驗證碼密鑰後，就會顯示在這裡。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "喺登入項目加入驗證碼密鑰之後，就會顯示喺呢度。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在登录项中添加验证码密钥后，就会显示在这里。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインにコードのシークレットを追加すると、ここに表示されます。"
          }
        }
      }
    },
