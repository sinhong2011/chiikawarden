    "In Trash. Restore it to use it again, or delete it forever.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱にあります。復元して再び使うか、完全に削除してください。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
