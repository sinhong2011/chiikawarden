          "stringUnit": {
            "state": "translated",
            "value": "連結會立即失效。"
          }
        }
      }
    },
    "The server sent unsafe key-derivation settings. Login was stopped.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーから安全でない鍵導出設定が送られたため、ログインを中止しました。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器傳回不安全的金鑰衍生設定，已停止登入。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器返回了不安全的密钥派生设置，已停止登录。"
